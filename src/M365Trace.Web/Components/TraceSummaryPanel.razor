<details class="trace-summary">
    <summary>
        <span>Trace summary</span>
        <span class="trace-summary-caption">@VisibleSessionCount.ToString("N0") visible of @Summary.TotalSessions.ToString("N0")</span>
    </summary>

    <div class="trace-summary-content">
        <section class="summary-overview" aria-label="Trace overview">
            <button type="button"
                    class="summary-metric summary-filter-button"
                    title="Clear filters and show all sessions"
                    @onclick="ClearAllRequested">
                <span>Sessions</span>
                <strong>@Summary.TotalSessions.ToString("N0")</strong>
            </button>
            <div class="summary-metric">
                <span>Visible</span>
                <strong>@VisibleSessionCount.ToString("N0")</strong>
            </div>
            <div class="summary-metric">
                <span>Trace window</span>
                <strong>@FormatDuration(Summary.TraceWindow)</strong>
                <small>@FormatTraceRange()</small>
            </div>
            <button type="button"
                    class="summary-metric summary-filter-button"
                    disabled="@(Summary.SessionsWithFindings == 0)"
                    @onclick="() => FindingsSelected.InvokeAsync(SessionFindingFilter.HasFindings)">
                <span>Sessions with findings</span>
                <strong>@Summary.SessionsWithFindings.ToString("N0")</strong>
            </button>
            <button type="button"
                    class="summary-metric summary-filter-button"
                    disabled="@(Summary.SlowSessions == 0)"
                    @onclick="() => FindingSelected.InvokeAsync(TraceSummaryService.PerformanceFindingRuleId)">
                <span>Slow sessions</span>
                <strong>@Summary.SlowSessions.ToString("N0")</strong>
            </button>
        </section>

        <div class="summary-sections">
            <section class="summary-section" aria-labelledby="severity-summary">
                <h3 id="severity-summary">Analysis severity</h3>
                <div class="summary-count-grid">
                    @RenderSeverityButton(
                        TraceSeverityFilter.Severe,
                        Summary.Severities.Severe)
                    @RenderSeverityButton(
                        TraceSeverityFilter.Concerning,
                        Summary.Severities.Concerning)
                    @RenderSeverityButton(
                        TraceSeverityFilter.Warning,
                        Summary.Severities.Warning)
                    @RenderSeverityButton(
                        TraceSeverityFilter.Normal,
                        Summary.Severities.Normal)
                    @RenderSeverityButton(
                        TraceSeverityFilter.Other,
                        Summary.Severities.Other)
                </div>
            </section>

            <section class="summary-section" aria-labelledby="status-summary">
                <h3 id="status-summary">HTTP status</h3>
                <div class="summary-count-grid">
                    @RenderStatusButton(
                        TraceStatusFamily.NoResponse,
                        Summary.Statuses.NoResponse)
                    @RenderStatusButton(
                        TraceStatusFamily.Success,
                        Summary.Statuses.Success)
                    @RenderStatusButton(
                        TraceStatusFamily.Redirect,
                        Summary.Statuses.Redirect)
                    @RenderStatusButton(
                        TraceStatusFamily.ClientError,
                        Summary.Statuses.ClientError)
                    @RenderStatusButton(
                        TraceStatusFamily.ServerError,
                        Summary.Statuses.ServerError)
                    @if (Summary.Statuses.Other > 0)
                    {
                        @RenderStatusButton(
                            TraceStatusFamily.Other,
                            Summary.Statuses.Other)
                    }
                </div>
            </section>

            <SummaryRankedList Title="Failing hosts"
                               EmptyText="No failing hosts observed."
                               Items="FailingHostItems"
                               ItemSelected="SelectHostAsync" />

            <SummaryRankedList Title="High-impact findings"
                               EmptyText="No concerning or severe findings."
                               Items="HighImpactFindingItems"
                               UseCodeLabels="true"
                               ItemSelected="SelectFindingAsync" />

            <section class="summary-section" aria-labelledby="slowest-summary">
                <h3 id="slowest-summary">Slowest sessions</h3>
                @if (Summary.SlowestSessions.Count == 0)
                {
                    <p class="summary-empty">No sessions available.</p>
                }
                else
                {
                    <ol class="summary-ranked-list">
                        @foreach (var session in Summary.SlowestSessions)
                        {
                            <li>
                                <button type="button"
                                        class="summary-ranked-button"
                                        title="@($"{session.Method} {session.Host}{session.Path}")"
                                        @onclick="() => SessionSelected.InvokeAsync(session.SessionId)">
                                    <span class="summary-session-label">
                                        #@session.SessionId
                                        @session.Method
                                        @session.Host@session.Path
                                    </span>
                                    <strong>@FormatDuration(session.Duration)</strong>
                                </button>
                            </li>
                        }
                    </ol>
                }
            </section>

            <SummaryRankedList Title="Authentication"
                               EmptyText="No authentication classifications."
                               Items="AuthenticationItems"
                               ItemSelected="SelectAuthenticationAsync" />
        </div>
    </div>
</details>

@code {
    [Parameter, EditorRequired]
    public required TraceSummary Summary { get; set; }

    [Parameter]
    public int VisibleSessionCount { get; set; }

    [Parameter]
    public EventCallback ClearAllRequested { get; set; }

    [Parameter]
    public EventCallback<TraceSeverityFilter> SeveritySelected { get; set; }

    [Parameter]
    public EventCallback<TraceStatusFamily> StatusSelected { get; set; }

    [Parameter]
    public EventCallback<SessionFindingFilter> FindingsSelected { get; set; }

    [Parameter]
    public EventCallback<string> HostSelected { get; set; }

    [Parameter]
    public EventCallback<string> FindingSelected { get; set; }

    [Parameter]
    public EventCallback<string> AuthenticationSelected { get; set; }

    [Parameter]
    public EventCallback<int> SessionSelected { get; set; }

    private IReadOnlyList<SummaryRankedItem> FailingHostItems =>
        Summary.FailingHosts
            .Select(item => new SummaryRankedItem(item.Name, item.Count))
            .ToArray();

    private IReadOnlyList<SummaryRankedItem> HighImpactFindingItems =>
        Summary.HighImpactFindings
            .Select(item => new SummaryRankedItem(item.RuleId, item.Count))
            .ToArray();

    private IReadOnlyList<SummaryRankedItem> AuthenticationItems =>
        Summary.AuthenticationTypes
            .Select(item => new SummaryRankedItem(item.Name, item.Count))
            .ToArray();

    private RenderFragment RenderSeverityButton(
        TraceSeverityFilter severity,
        int count) => builder =>
    {
        builder.OpenElement(0, "button");
        builder.AddAttribute(1, "type", "button");
        builder.AddAttribute(2, "class", "summary-count-button");
        builder.AddAttribute(3, "disabled", count == 0);
        builder.AddAttribute(
            4,
            "onclick",
            EventCallback.Factory.Create(
                this,
                () => SeveritySelected.InvokeAsync(severity)));
        builder.OpenElement(5, "span");
        builder.AddContent(6, TraceFilterBar.GetSeverityLabel(severity));
        builder.CloseElement();
        builder.OpenElement(7, "strong");
        builder.AddContent(8, count);
        builder.CloseElement();
        builder.CloseElement();
    };

    private RenderFragment RenderStatusButton(
        TraceStatusFamily family,
        int count) => builder =>
    {
        builder.OpenElement(0, "button");
        builder.AddAttribute(1, "type", "button");
        builder.AddAttribute(2, "class", "summary-count-button");
        builder.AddAttribute(3, "disabled", count == 0);
        builder.AddAttribute(
            4,
            "onclick",
            EventCallback.Factory.Create(
                this,
                () => StatusSelected.InvokeAsync(family)));
        builder.OpenElement(5, "span");
        builder.AddContent(6, TraceFilterBar.GetStatusFamilyLabel(family));
        builder.CloseElement();
        builder.OpenElement(7, "strong");
        builder.AddContent(8, count);
        builder.CloseElement();
        builder.CloseElement();
    };

    private Task SelectHostAsync(SummaryRankedItem item) =>
        HostSelected.InvokeAsync(item.Label);

    private Task SelectFindingAsync(SummaryRankedItem item) =>
        FindingSelected.InvokeAsync(item.Label);

    private Task SelectAuthenticationAsync(SummaryRankedItem item) =>
        AuthenticationSelected.InvokeAsync(item.Label);

    private string FormatTraceRange()
    {
        if (Summary.TraceStart is null || Summary.TraceEnd is null)
        {
            return "No timing data";
        }

        return $"{Summary.TraceStart.Value.ToLocalTime():G} – "
            + $"{Summary.TraceEnd.Value.ToLocalTime():G}";
    }

    private static string FormatDuration(TimeSpan duration)
    {
        if (duration.TotalDays >= 1)
        {
            return $"{duration.TotalDays:N1} d";
        }

        if (duration.TotalHours >= 1)
        {
            return $"{duration.TotalHours:N1} h";
        }

        if (duration.TotalMinutes >= 1)
        {
            return $"{duration.TotalMinutes:N1} min";
        }

        if (duration.TotalSeconds >= 1)
        {
            return $"{duration.TotalSeconds:N2} s";
        }

        return $"{duration.TotalMilliseconds:N0} ms";
    }
}
