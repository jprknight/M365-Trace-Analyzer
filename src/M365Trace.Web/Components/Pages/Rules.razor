@page "/rules"
@page "/classifications"
@inject RuleCatalog RuleCatalog

<PageTitle>Installed Rules - M365 Trace Analyzer</PageTitle>

<section class="rules-page">
    <div class="rules-page-heading">
        <div>
            <p class="eyebrow">Ruleset coverage</p>
            <h1>Supported session classifications</h1>
            <p>
                Ruleset @RuleCatalog.Manifest.RulesetVersion ·
                schema @RuleCatalog.Manifest.SchemaVersion ·
                released @RuleCatalog.Manifest.Released.ToString("yyyy-MM-dd") ·
                @RuleCatalog.Manifest.SessionClassificationCount session classifications
            </p>
            <p class="technical-summary">
                These classifications are implemented by
                @RuleCatalog.Rules.Count processing components. The table below
                is the technical implementation inventory.
            </p>
        </div>
        <a class="secondary-button" href="/">Back to analyzer</a>
    </div>

    <div class="rules-table-container">
        <table class="rules-table">
            <thead>
                <tr>
                    <th>Implementation ID</th>
                    <th>Phase</th>
                    <th>Order</th>
                    <th>Implementation</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var rule in RuleCatalog.Rules)
                {
                    <tr>
                        <td><code>@rule.Id</code></td>
                        <td>@rule.Phase</td>
                        <td>@rule.Order</td>
                        <td>@rule.GetType().Name</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
