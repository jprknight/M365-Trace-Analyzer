@page "/"
@inject IEnumerable<ITraceImporter> TraceImporters
@inject TraceAnalysisEngine AnalysisEngine
@inject RuleCatalog RuleCatalog
@inject M365Trace.Web.Services.VersionUpdateService VersionUpdateService

<PageTitle>M365 Trace Analyzer</PageTitle>

<header class="app-header">
    <div>
        <p class="eyebrow">Microsoft 365 diagnostics</p>
        <h1>M365 Trace Analyzer</h1>
        <p class="subtitle">Analyze HTTP Archive files locally. Trace data is processed by this application and is not uploaded to an external service.</p>
    </div>

    <div class="header-actions">
        <div class="version-card @GetVersionStatusClass()"
             title="@versionCheck?.Detail">
            <span>Version @VersionUpdateService.CurrentVersion</span>
            <span>Ruleset @RuleCatalog.Manifest.RulesetVersion</span>
            @if (versionCheck is null)
            {
                <strong>Checking for updates...</strong>
            }
            else if (versionCheck.State == M365Trace.Web.Services.VersionCheckState.UpdateAvailable)
            {
                @if (versionCheck.ReleaseUri is not null)
                {
                    <a href="@versionCheck.ReleaseUri"
                       target="_blank"
                       rel="noopener noreferrer">
                        Version @versionCheck.LatestVersion available
                    </a>
                }
                else
                {
                    <strong>Version @versionCheck.LatestVersion available</strong>
                }
            }
            else
            {
                <strong>@GetVersionStatusText()</strong>
            }
            <a class="rules-link" href="/classifications">View classification coverage</a>
        </div>

        <label class="file-button @(isLoading ? "disabled" : null)">
            <span>@(isLoading ? "Loading..." : "Open HAR or SAZ")</span>
            <InputFile OnChange="LoadTraceAsync"
                       accept=".har,.saz,application/json,application/zip"
                       disabled="@isLoading" />
        </label>
    </div>
</header>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="message error-message" role="alert">
        <strong>Unable to open the trace.</strong>
        <span>@errorMessage</span>
    </div>
}

@if (sessions.Count == 0 && !isLoading)
{
    <section class="empty-state">
        <div class="empty-icon">TRACE</div>
        <h2>Open a HAR or SAZ trace</h2>
        <p>Select a HAR file exported from browser developer tools or an unencrypted Fiddler Session Archive.</p>
    </section>
}
else if (sessions.Count > 0)
{
    <section class="workspace">
        <div class="session-panel">
            <div class="panel-heading">
                <div>
                    <h2>@fileName</h2>
                    <p>@sessions.Count.ToString("N0") sessions</p>
                </div>
                <input class="search-box"
                       placeholder="Filter by analysis, host, path, method, or status"
                       @bind="filterText"
                       @bind:event="oninput"
                       aria-label="Filter sessions by analysis, host, path, method, or status" />
            </div>

            <div class="table-container">
                <table class="session-table">
                    <thead>
                        <tr>
                            <th aria-sort="@GetAriaSort(SessionSortColumn.Id)">
                                <button type="button"
                                        class="@GetSortButtonClass(SessionSortColumn.Id)"
                                        @onclick="() => SetSort(SessionSortColumn.Id)">#</button>
                            </th>
                            <th aria-sort="@GetAriaSort(SessionSortColumn.Analysis)">
                                <button type="button"
                                        class="@GetSortButtonClass(SessionSortColumn.Analysis)"
                                        @onclick="() => SetSort(SessionSortColumn.Analysis)">Analysis</button>
                            </th>
                            <th aria-sort="@GetAriaSort(SessionSortColumn.Status)">
                                <button type="button"
                                        class="@GetSortButtonClass(SessionSortColumn.Status)"
                                        @onclick="() => SetSort(SessionSortColumn.Status)">Status</button>
                            </th>
                            <th aria-sort="@GetAriaSort(SessionSortColumn.Method)">
                                <button type="button"
                                        class="@GetSortButtonClass(SessionSortColumn.Method)"
                                        @onclick="() => SetSort(SessionSortColumn.Method)">Method</button>
                            </th>
                            <th aria-sort="@GetAriaSort(SessionSortColumn.Host)">
                                <button type="button"
                                        class="@GetSortButtonClass(SessionSortColumn.Host)"
                                        @onclick="() => SetSort(SessionSortColumn.Host)">Host</button>
                            </th>
                            <th aria-sort="@GetAriaSort(SessionSortColumn.Path)">
                                <button type="button"
                                        class="@GetSortButtonClass(SessionSortColumn.Path)"
                                        @onclick="() => SetSort(SessionSortColumn.Path)">Path</button>
                            </th>
                            <th aria-sort="@GetAriaSort(SessionSortColumn.Duration)">
                                <button type="button"
                                        class="@GetSortButtonClass(SessionSortColumn.Duration)"
                                        @onclick="() => SetSort(SessionSortColumn.Duration)">Duration</button>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var session in FilteredSessions)
                        {
                            <tr class="@(selectedSession?.Id == session.Id ? "selected" : null)"
                                @onclick="() => SelectSession(session)">
                                <td>@session.Id</td>
                                <td>
                                    <span class="severity-badge @GetSeverityClass(session.Analysis.Severity)">
                                        @GetSeverityLabel(session.Analysis.Severity)
                                    </span>
                                </td>
                                <td><span class="status-code @GetStatusClass(session.StatusCode)">@session.StatusCode</span></td>
                                <td><span class="method">@session.Method</span></td>
                                <td>@session.Url.Host</td>
                                <td class="path-cell" title="@session.Url.PathAndQuery">@session.Url.PathAndQuery</td>
                                <td>@FormatDuration(session.Duration)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <aside class="detail-panel">
            @if (selectedSession is null)
            {
                <div class="detail-placeholder">Select a session to inspect its request and response.</div>
            }
            else
            {
                @if (selectedSession.Analysis.HasFindings)
                {
                    <section class="analysis-section @GetAnalysisSeverityClass(selectedSession.Analysis.Severity)">
                        <div class="analysis-heading">
                            <div>
                                <p class="eyebrow">Ruleset analysis</p>
                                <h3>@GetSeverityLabel(selectedSession.Analysis.Severity)</h3>
                            </div>
                            <span class="severity-badge large @GetSeverityClass(selectedSession.Analysis.Severity)">
                                @((int?)selectedSession.Analysis.Severity)
                            </span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(selectedSession.Analysis.SessionType))
                        {
                            <div class="classification-row">
                                <span>Session type</span>
                                <strong>@selectedSession.Analysis.SessionType</strong>
                                <small>Confidence @selectedSession.Analysis.SessionTypeConfidence/10</small>
                            </div>
                        }

                        @foreach (var finding in selectedSession.Analysis.Findings)
                        {
                            <article class="finding-card @GetAnalysisSeverityClass(finding.Severity)">
                                <h4>@finding.Title</h4>
                                <code>@finding.RuleId</code>

                                @if (!string.IsNullOrWhiteSpace(finding.Description))
                                {
                                    <p>@finding.Description</p>
                                }

                                @if (!string.IsNullOrWhiteSpace(finding.Evidence))
                                {
                                    <div class="finding-detail">
                                        <span>Evidence</span>
                                        <p>@finding.Evidence</p>
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(finding.Recommendation))
                                {
                                    <div class="finding-detail">
                                        <span>Recommended investigation</span>
                                        <p>@finding.Recommendation</p>
                                    </div>
                                }

                                @foreach (var link in finding.Links)
                                {
                                    <a class="finding-link"
                                       href="@link.Url"
                                       target="_blank"
                                       rel="noopener noreferrer">@link.Label</a>
                                }
                            </article>
                        }
                    </section>
                }
                else
                {
                    <div class="analysis-unavailable">
                        No migrated analysis rule matched this session yet.
                    </div>
                }

                <div class="detail-heading">
                    <span class="status-code @GetStatusClass(selectedSession.StatusCode)">@selectedSession.StatusCode</span>
                    <div>
                        <h2>@selectedSession.Method @selectedSession.Url.Host</h2>
                        <p>@selectedSession.Url</p>
                    </div>
                </div>

                <div class="detail-metrics">
                    <div><span>Started</span><strong>@selectedSession.StartedAt.ToLocalTime().ToString("G")</strong></div>
                    <div><span>Duration</span><strong>@FormatDuration(selectedSession.Duration)</strong></div>
                    <div><span>Status</span><strong>@selectedSession.StatusText</strong></div>
                </div>

                <details open>
                    <summary>Request headers (@selectedSession.RequestHeaders.Count)</summary>
                    <div class="header-list">@RenderHeaders(selectedSession.RequestHeaders)</div>
                </details>

                @if (selectedSession.RequestContent is not null)
                {
                    <details>
                        <summary>Request body</summary>
                        <BodyInspector @key="@($"request-{selectedSession.Id}")"
                                       Content="selectedSession.RequestContent" />
                    </details>
                }

                <details open>
                    <summary>Response headers (@selectedSession.ResponseHeaders.Count)</summary>
                    <div class="header-list">@RenderHeaders(selectedSession.ResponseHeaders)</div>
                </details>

                @if (selectedSession.ResponseContent is not null)
                {
                    <details open>
                        <summary>Response body</summary>
                        <BodyInspector @key="@($"response-{selectedSession.Id}")"
                                       Content="selectedSession.ResponseContent" />
                    </details>
                }
            }
        </aside>
    </section>
}

@code {
    private const long MaximumBrowserFileSize = HarImportOptions.DefaultMaximumFileSize;

    private readonly List<TraceSession> sessions = [];
    private TraceSession? selectedSession;
    private string? errorMessage;
    private string? fileName;
    private string filterText = string.Empty;
    private bool isLoading;
    private M365Trace.Web.Services.VersionCheckResult? versionCheck;
    private SessionSortColumn sortColumn = SessionSortColumn.Id;
    private bool sortAscending = true;

    protected override async Task OnInitializedAsync()
    {
        versionCheck = await VersionUpdateService.CheckForUpdatesAsync();
    }

    private IEnumerable<TraceSession> FilteredSessions
    {
        get
        {
            IEnumerable<TraceSession> filteredSessions =
                string.IsNullOrWhiteSpace(filterText)
                    ? sessions
                    : sessions.Where(session =>
                        MatchesFilter(session, filterText.Trim()));

            return SortSessions(filteredSessions);
        }
    }

    private IEnumerable<TraceSession> SortSessions(
        IEnumerable<TraceSession> source)
    {
        Func<TraceSession, object?> selector = sortColumn switch
        {
            SessionSortColumn.Id => session => session.Id,
            SessionSortColumn.Analysis => session =>
                (int?)session.Analysis.Severity ?? -1,
            SessionSortColumn.Status => session => session.StatusCode,
            SessionSortColumn.Method => session => session.Method,
            SessionSortColumn.Host => session => session.Url.Host,
            SessionSortColumn.Path => session => session.Url.PathAndQuery,
            SessionSortColumn.Duration => session => session.Duration.Ticks,
            _ => session => session.Id
        };

        return sortAscending
            ? source.OrderBy(selector, SessionSortValueComparer.Instance)
                .ThenBy(session => session.Id)
            : source.OrderByDescending(
                    selector,
                    SessionSortValueComparer.Instance)
                .ThenBy(session => session.Id);
    }

    private void SetSort(SessionSortColumn column)
    {
        if (sortColumn == column)
        {
            sortAscending = !sortAscending;
            return;
        }

        sortColumn = column;
        sortAscending = true;
    }

    private string GetSortButtonClass(SessionSortColumn column) =>
        sortColumn == column
            ? $"sort-button active {(sortAscending ? "ascending" : "descending")}"
            : "sort-button";

    private string GetAriaSort(SessionSortColumn column) =>
        sortColumn != column
            ? "none"
            : sortAscending
                ? "ascending"
                : "descending";

    private static bool MatchesFilter(TraceSession session, string filter)
    {
        var analysis = session.Analysis;

        return ContainsFilter(session.Url.AbsoluteUri, filter)
            || ContainsFilter(session.Url.Host, filter)
            || ContainsFilter(session.Url.PathAndQuery, filter)
            || ContainsFilter(session.Method, filter)
            || ContainsFilter(session.StatusCode.ToString(), filter)
            || ContainsFilter(session.StatusText, filter)
            || ContainsFilter(GetSeverityLabel(analysis.Severity), filter)
            || ContainsFilter(analysis.SessionType, filter)
            || ContainsFilter(analysis.Authentication, filter)
            || ContainsFilter(analysis.ResponseServer, filter)
            || analysis.Findings.Any(finding =>
                ContainsFilter(finding.RuleId, filter)
                || ContainsFilter(finding.Title, filter)
                || ContainsFilter(finding.Description, filter)
                || ContainsFilter(finding.Recommendation, filter)
                || ContainsFilter(finding.Evidence, filter));
    }

    private static bool ContainsFilter(string? value, string filter) =>
        value?.Contains(filter, StringComparison.OrdinalIgnoreCase) == true;

    private async Task LoadTraceAsync(InputFileChangeEventArgs args)
    {
        isLoading = true;
        errorMessage = null;
        sessions.Clear();
        selectedSession = null;
        fileName = null;

        try
        {
            var file = args.File;
            var importer = TraceImporters.FirstOrDefault(candidate =>
                candidate.CanImport(file.Name))
                ?? throw new TraceImportException(
                    "Select a supported .har or .saz trace file.");

            await using var stream = file.OpenReadStream(MaximumBrowserFileSize);
            var importedSessions = await importer.ImportAsync(stream);

            sessions.AddRange(importedSessions.Select(session =>
                session with { Analysis = AnalysisEngine.Analyze(session) }));
            selectedSession = sessions.FirstOrDefault();
            fileName = file.Name;
        }
        catch (Exception exception) when (
            exception is TraceImportException
            or IOException
            or InvalidOperationException)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SelectSession(TraceSession session)
    {
        selectedSession = session;
    }

    private static string GetStatusClass(int statusCode) => statusCode switch
    {
        >= 500 => "status-error",
        >= 400 => "status-warning",
        >= 300 => "status-redirect",
        >= 200 => "status-success",
        _ => "status-neutral"
    };

    private static string GetSeverityLabel(TraceSeverity? severity) => severity switch
    {
        TraceSeverity.InternalError => "Internal error",
        TraceSeverity.Uninteresting => "Uninteresting",
        TraceSeverity.FalsePositive => "False positive",
        TraceSeverity.Normal => "Normal",
        TraceSeverity.Warning => "Warning",
        TraceSeverity.Concerning => "Concerning",
        TraceSeverity.Severe => "Severe",
        _ => "Not analyzed"
    };

    private static string GetSeverityClass(TraceSeverity? severity) => severity switch
    {
        TraceSeverity.InternalError => "severity-internal-error",
        TraceSeverity.Uninteresting => "severity-uninteresting",
        TraceSeverity.FalsePositive => "severity-false-positive",
        TraceSeverity.Normal => "severity-normal",
        TraceSeverity.Warning => "severity-warning",
        TraceSeverity.Concerning => "severity-concerning",
        TraceSeverity.Severe => "severity-severe",
        _ => "severity-unclassified"
    };

    private static string GetAnalysisSeverityClass(
        TraceSeverity? severity) => severity switch
    {
        TraceSeverity.InternalError => "analysis-internal-error",
        TraceSeverity.Uninteresting => "analysis-uninteresting",
        TraceSeverity.FalsePositive => "analysis-false-positive",
        TraceSeverity.Normal => "analysis-normal",
        TraceSeverity.Warning => "analysis-warning",
        TraceSeverity.Concerning => "analysis-concerning",
        TraceSeverity.Severe => "analysis-severe",
        _ => "analysis-unclassified"
    };

    private static string FormatDuration(TimeSpan duration) =>
        duration.TotalSeconds >= 1
            ? $"{duration.TotalSeconds:N2} s"
            : $"{duration.TotalMilliseconds:N0} ms";

    private string GetVersionStatusClass() => versionCheck?.State switch
    {
        M365Trace.Web.Services.VersionCheckState.Latest => "version-latest",
        M365Trace.Web.Services.VersionCheckState.UpdateAvailable => "version-update",
        M365Trace.Web.Services.VersionCheckState.NoPublishedRelease => "version-no-release",
        M365Trace.Web.Services.VersionCheckState.Unavailable => "version-unavailable",
        _ => "version-checking"
    };

    private string GetVersionStatusText() => versionCheck?.State switch
    {
        M365Trace.Web.Services.VersionCheckState.Latest =>
            "Latest available version",
        M365Trace.Web.Services.VersionCheckState.NoPublishedRelease =>
            "No published release yet",
        M365Trace.Web.Services.VersionCheckState.Unavailable =>
            "Update check unavailable",
        _ => "Checking for updates..."
    };

    private static RenderFragment RenderHeaders(IReadOnlyList<TraceHeader> headers) => builder =>
    {
        if (headers.Count == 0)
        {
            builder.OpenElement(0, "p");
            builder.AddAttribute(1, "class", "muted");
            builder.AddContent(2, "No headers were recorded.");
            builder.CloseElement();
            return;
        }

        var sequence = 0;
        foreach (var header in headers)
        {
            builder.OpenElement(sequence++, "div");
            builder.AddAttribute(sequence++, "class", "header-row");
            builder.OpenElement(sequence++, "span");
            builder.AddContent(sequence++, header.Name);
            builder.CloseElement();
            builder.OpenElement(sequence++, "code");
            builder.AddContent(sequence++, header.Value);
            builder.CloseElement();
            builder.CloseElement();
        }
    };

    private enum SessionSortColumn
    {
        Id,
        Analysis,
        Status,
        Method,
        Host,
        Path,
        Duration
    }

    private sealed class SessionSortValueComparer : IComparer<object?>
    {
        public static SessionSortValueComparer Instance { get; } = new();

        public int Compare(object? left, object? right)
        {
            if (ReferenceEquals(left, right))
            {
                return 0;
            }

            if (left is null)
            {
                return -1;
            }

            if (right is null)
            {
                return 1;
            }

            if (left is string leftText && right is string rightText)
            {
                return StringComparer.OrdinalIgnoreCase.Compare(
                    leftText,
                    rightText);
            }

            return Comparer<object>.Default.Compare(left, right);
        }
    }
}
