<section class="summary-section" aria-labelledby="@HeadingId">
    <h3 id="@HeadingId">@Title</h3>
    @if (Items.Count == 0)
    {
        <p class="summary-empty">@EmptyText</p>
    }
    else
    {
        <ol class="summary-ranked-list">
            @foreach (var item in Items)
            {
                <li>
                    @if (UseCodeLabels)
                    {
                        <code title="@item.Label">@item.Label</code>
                    }
                    else
                    {
                        <span title="@item.Label">@item.Label</span>
                    }
                    <strong>@item.Count.ToString("N0")</strong>
                </li>
            }
        </ol>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public required string Title { get; set; }

    [Parameter, EditorRequired]
    public required string EmptyText { get; set; }

    [Parameter, EditorRequired]
    public required IReadOnlyList<SummaryRankedItem> Items { get; set; }

    [Parameter]
    public bool UseCodeLabels { get; set; }

    private string HeadingId =>
        $"summary-{Title.ToLowerInvariant().Replace(' ', '-')}";
}
