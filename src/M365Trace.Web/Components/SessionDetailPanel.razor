<aside class="detail-panel">
    @if (Session is null)
    {
        <div class="detail-placeholder">
            Select a session to inspect its request and response.
        </div>
    }
    else
    {
        @if (Session.Analysis.HasFindings)
        {
            <section class="analysis-section @TraceDisplayFormatter.GetAnalysisSeverityClass(Session.Analysis.Severity)">
                <div class="analysis-heading">
                    <div>
                        <p class="eyebrow">Ruleset analysis</p>
                        <h3>@TraceDisplayFormatter.GetSeverityLabel(Session.Analysis.Severity)</h3>
                    </div>
                    <span class="severity-badge large @TraceDisplayFormatter.GetSeverityClass(Session.Analysis.Severity)">
                        @((int?)Session.Analysis.Severity)
                    </span>
                </div>

                @if (!string.IsNullOrWhiteSpace(Session.Analysis.SessionType))
                {
                    <div class="classification-row">
                        <span>Session type</span>
                        <strong>@Session.Analysis.SessionType</strong>
                    </div>
                }

                @foreach (var finding in Session.Analysis.Findings)
                {
                    <article class="finding-card @TraceDisplayFormatter.GetAnalysisSeverityClass(finding.Severity)">
                        <h4>@finding.Title</h4>
                        <code>@finding.RuleId</code>

                        @if (!string.IsNullOrWhiteSpace(finding.Description))
                        {
                            <p>@finding.Description</p>
                        }

                        @if (!string.IsNullOrWhiteSpace(finding.Evidence))
                        {
                            <div class="finding-detail">
                                <span>Evidence</span>
                                <p>@finding.Evidence</p>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(finding.Recommendation))
                        {
                            <div class="finding-detail">
                                <span>Recommended investigation</span>
                                <p>@finding.Recommendation</p>
                            </div>
                        }

                        @foreach (var link in finding.Links)
                        {
                            <a class="finding-link"
                               href="@link.Url"
                               target="_blank"
                               rel="noopener noreferrer">@link.Label</a>
                        }
                    </article>
                }
            </section>
        }
        else
        {
            <div class="analysis-unavailable">
                No migrated analysis rule matched this session yet.
            </div>
        }

        <div class="detail-heading">
            <span class="status-code @TraceDisplayFormatter.GetStatusClass(Session.StatusCode)">
                @Session.StatusCode
            </span>
            <div>
                <h2>@Session.Method @Session.Url.Host</h2>
                <p>@Session.Url</p>
            </div>
        </div>

        <div class="detail-metrics">
            <div>
                <span>Started</span>
                <strong>@Session.StartedAt.ToLocalTime().ToString("G")</strong>
            </div>
            <div>
                <span>Duration</span>
                <strong>@TraceDisplayFormatter.FormatDuration(Session.Duration)</strong>
            </div>
            <div>
                <span>Status</span>
                <strong>@Session.StatusText</strong>
            </div>
        </div>

        <div class="traffic-view-selector"
             role="group"
             aria-label="Choose request and response details to display">
            <button type="button"
                    class="@GetTrafficViewButtonClass(DetailTrafficView.Request)"
                    aria-pressed="@(TrafficView == DetailTrafficView.Request)"
                    @onclick="() => SetTrafficViewAsync(DetailTrafficView.Request)">Request</button>
            <button type="button"
                    class="@GetTrafficViewButtonClass(DetailTrafficView.Response)"
                    aria-pressed="@(TrafficView == DetailTrafficView.Response)"
                    @onclick="() => SetTrafficViewAsync(DetailTrafficView.Response)">Response</button>
            <button type="button"
                    class="@GetTrafficViewButtonClass(DetailTrafficView.Both)"
                    aria-pressed="@(TrafficView == DetailTrafficView.Both)"
                    @onclick="() => SetTrafficViewAsync(DetailTrafficView.Both)">Both</button>
        </div>

        @if (TrafficView != DetailTrafficView.Response)
        {
            <details open>
                <summary>Request headers (@Session.RequestHeaders.Count)</summary>
                <div class="header-list">@RenderHeaders(Session.RequestHeaders)</div>
            </details>

            @if (Session.RequestContent is not null)
            {
                <details>
                    <summary>Request body</summary>
                    <BodyInspector @key="@($"request-{Session.Id}")"
                                   Content="Session.RequestContent" />
                </details>
            }
        }

        @if (TrafficView != DetailTrafficView.Request)
        {
            <details open>
                <summary>Response headers (@Session.ResponseHeaders.Count)</summary>
                <div class="header-list">@RenderHeaders(Session.ResponseHeaders)</div>
            </details>

            @if (Session.ResponseContent is not null)
            {
                <details open>
                    <summary>Response body</summary>
                    <BodyInspector @key="@($"response-{Session.Id}")"
                                   Content="Session.ResponseContent" />
                </details>
            }
        }
    }
</aside>

@code {
    [Parameter]
    public TraceSession? Session { get; set; }

    [Parameter]
    public DetailTrafficView TrafficView { get; set; } =
        DetailTrafficView.Both;

    [Parameter]
    public EventCallback<DetailTrafficView> TrafficViewChanged { get; set; }

    private Task SetTrafficViewAsync(DetailTrafficView view) =>
        TrafficViewChanged.InvokeAsync(view);

    private string GetTrafficViewButtonClass(DetailTrafficView view) =>
        TrafficView == view
            ? "traffic-view-button active"
            : "traffic-view-button";

    private static RenderFragment RenderHeaders(
        IReadOnlyList<TraceHeader> headers) => builder =>
    {
        if (headers.Count == 0)
        {
            builder.OpenElement(0, "p");
            builder.AddAttribute(1, "class", "muted");
            builder.AddContent(2, "No headers were recorded.");
            builder.CloseElement();
            return;
        }

        var sequence = 0;
        foreach (var header in headers)
        {
            builder.OpenElement(sequence++, "div");
            builder.AddAttribute(sequence++, "class", "header-row");
            builder.OpenElement(sequence++, "span");
            builder.AddContent(sequence++, header.Name);
            builder.CloseElement();
            builder.OpenElement(sequence++, "code");
            builder.AddContent(sequence++, header.Value);
            builder.CloseElement();
            builder.CloseElement();
        }
    };
}
