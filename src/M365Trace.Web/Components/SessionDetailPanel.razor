@inject DiagnosticHeaderService DiagnosticHeaderService
@inject SessionCopyFormatter CopyFormatter
@inject IClipboardService ClipboardService

<aside class="detail-panel">
    @if (Session is null)
    {
        <div class="detail-placeholder">
            Select a session to inspect its request and response.
        </div>
    }
    else
    {
        <div class="detail-action-bar">
            <div class="session-navigation"
                 role="group"
                 aria-label="Navigate matching sessions">
                <button type="button"
                        class="detail-action-button"
                        disabled="@(!CanSelectPrevious)"
                        data-session-navigation="previous"
                        @onclick="SelectPreviousRequested">
                    Previous match
                </button>
                <button type="button"
                        class="detail-action-button"
                        disabled="@(!CanSelectNext)"
                        data-session-navigation="next"
                        @onclick="SelectNextRequested">
                    Next match
                </button>
            </div>

            <div class="copy-actions"
                 role="group"
                 aria-label="Copy session evidence">
                <button type="button"
                        class="detail-action-button"
                        data-copy-action="url"
                        @onclick="CopyUrlAsync">Copy URL</button>
                <button type="button"
                        class="detail-action-button"
                        data-copy-action="request-headers"
                        disabled="@(Session.RequestHeaders.Count == 0)"
                        @onclick="CopyRequestHeadersAsync">
                    Copy request headers
                </button>
                <button type="button"
                        class="detail-action-button"
                        data-copy-action="response-headers"
                        disabled="@(Session.ResponseHeaders.Count == 0)"
                        @onclick="CopyResponseHeadersAsync">
                    Copy response headers
                </button>
                <button type="button"
                        class="detail-action-button"
                        data-copy-action="request-body"
                        disabled="@(RequestBodyPayload is null)"
                        @onclick="CopyRequestBodyAsync">
                    Copy request body
                </button>
                <button type="button"
                        class="detail-action-button"
                        data-copy-action="response-body"
                        disabled="@(ResponseBodyPayload is null)"
                        @onclick="CopyResponseBodyAsync">
                    Copy response body
                </button>
                <button type="button"
                        class="detail-action-button"
                        data-copy-action="finding-summary"
                        disabled="@(FindingPayload is null)"
                        @onclick="CopyFindingsAsync">
                    Copy finding summary
                </button>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(copyStatus))
        {
            <p class="copy-status @GetCopyStatusClass()"
               role="status"
               aria-live="polite">@copyStatus</p>
        }

        @if (Session.Analysis.HasFindings)
        {
            <section class="analysis-section @TraceDisplayFormatter.GetAnalysisSeverityClass(Session.Analysis.Severity)">
                <div class="analysis-heading">
                    <div>
                        <p class="eyebrow">Ruleset analysis</p>
                        <h3>@TraceDisplayFormatter.GetSeverityLabel(Session.Analysis.Severity)</h3>
                    </div>
                    <span class="severity-badge large @TraceDisplayFormatter.GetSeverityClass(Session.Analysis.Severity)">
                        @((int?)Session.Analysis.Severity)
                    </span>
                </div>

                @if (!string.IsNullOrWhiteSpace(Session.Analysis.SessionType))
                {
                    <div class="classification-row">
                        <span>Session type</span>
                        <strong>@Session.Analysis.SessionType</strong>
                    </div>
                }

                @foreach (var finding in Session.Analysis.Findings)
                {
                    <article class="finding-card @TraceDisplayFormatter.GetAnalysisSeverityClass(finding.Severity)">
                        <h4>@finding.Title</h4>
                        <code>@finding.RuleId</code>

                        @if (!string.IsNullOrWhiteSpace(finding.Description))
                        {
                            <p>@finding.Description</p>
                        }

                        @if (!string.IsNullOrWhiteSpace(finding.Evidence))
                        {
                            <div class="finding-detail">
                                <span>Evidence</span>
                                <p>@finding.Evidence</p>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(finding.Recommendation))
                        {
                            <div class="finding-detail">
                                <span>Recommended investigation</span>
                                <p>@finding.Recommendation</p>
                            </div>
                        }

                        @foreach (var link in finding.Links)
                        {
                            <a class="finding-link"
                               href="@link.Url"
                               target="_blank"
                               rel="noopener noreferrer">@link.Label</a>
                        }
                    </article>
                }
            </section>
        }
        else
        {
            <div class="analysis-unavailable">
                No migrated analysis rule matched this session yet.
            </div>
        }

        <div class="detail-heading">
            <span class="status-code @TraceDisplayFormatter.GetStatusClass(Session.StatusCode)">
                @Session.StatusCode
            </span>
            <div>
                <h2>@Session.Method @Session.Url.Host</h2>
                <p>@Session.Url</p>
            </div>
        </div>

        <div class="detail-metrics">
            <div>
                <span>Started</span>
                <strong>@Session.StartedAt.ToLocalTime().ToString("G")</strong>
            </div>
            <div>
                <span>Duration</span>
                <strong>@TraceDisplayFormatter.FormatDuration(Session.Duration)</strong>
            </div>
            <div>
                <span>Status</span>
                <strong>@Session.StatusText</strong>
            </div>
        </div>

        @if (DiagnosticHeaders.Count > 0)
        {
            <section class="diagnostic-headers"
                     aria-labelledby="diagnostic-headers-heading">
                <div class="diagnostic-headers-heading">
                    <h3 id="diagnostic-headers-heading">
                        Diagnostic headers
                    </h3>
                    <span>@DiagnosticHeaders.Count recognized</span>
                </div>
                <div class="diagnostic-header-list">
                    @foreach (var header in DiagnosticHeaders)
                    {
                        <div class="diagnostic-header-row">
                            <span class="diagnostic-header-source">
                                @header.Source
                            </span>
                            <code class="diagnostic-header-name">
                                @header.Name
                            </code>
                            <code class="diagnostic-header-value">
                                @header.Value
                            </code>
                        </div>
                    }
                </div>
            </section>
        }

        <div class="traffic-view-selector"
             role="group"
             aria-label="Choose request and response details to display">
            <button type="button"
                    class="@GetTrafficViewButtonClass(DetailTrafficView.Request)"
                    aria-pressed="@(TrafficView == DetailTrafficView.Request)"
                    @onclick="() => SetTrafficViewAsync(DetailTrafficView.Request)">Request</button>
            <button type="button"
                    class="@GetTrafficViewButtonClass(DetailTrafficView.Response)"
                    aria-pressed="@(TrafficView == DetailTrafficView.Response)"
                    @onclick="() => SetTrafficViewAsync(DetailTrafficView.Response)">Response</button>
            <button type="button"
                    class="@GetTrafficViewButtonClass(DetailTrafficView.Both)"
                    aria-pressed="@(TrafficView == DetailTrafficView.Both)"
                    @onclick="() => SetTrafficViewAsync(DetailTrafficView.Both)">Both</button>
        </div>

        @if (TrafficView != DetailTrafficView.Response)
        {
            <details open>
                <summary>Request headers (@Session.RequestHeaders.Count)</summary>
                <div class="header-list">@RenderHeaders(Session.RequestHeaders)</div>
            </details>

            @if (Session.RequestContent is not null)
            {
                <details>
                    <summary>Request body</summary>
                    <BodyInspector @key="@($"request-{Session.Id}")"
                                   Content="Session.RequestContent" />
                </details>
            }
        }

        @if (TrafficView != DetailTrafficView.Request)
        {
            <details open>
                <summary>Response headers (@Session.ResponseHeaders.Count)</summary>
                <div class="header-list">@RenderHeaders(Session.ResponseHeaders)</div>
            </details>

            @if (Session.ResponseContent is not null)
            {
                <details open>
                    <summary>Response body</summary>
                    <BodyInspector @key="@($"response-{Session.Id}")"
                                   Content="Session.ResponseContent" />
                </details>
            }
        }
    }
</aside>

@code {
    [Parameter]
    public TraceSession? Session { get; set; }

    [Parameter]
    public DetailTrafficView TrafficView { get; set; } =
        DetailTrafficView.Both;

    [Parameter]
    public EventCallback<DetailTrafficView> TrafficViewChanged { get; set; }

    [Parameter]
    public bool CanSelectPrevious { get; set; }

    [Parameter]
    public bool CanSelectNext { get; set; }

    [Parameter]
    public EventCallback SelectPreviousRequested { get; set; }

    [Parameter]
    public EventCallback SelectNextRequested { get; set; }

    private int? previousSessionId;
    private string? copyStatus;
    private CopyStatusKind copyStatusKind;

    private IReadOnlyList<DiagnosticHeader> DiagnosticHeaders =>
        Session is null
            ? []
            : DiagnosticHeaderService.GetHeaders(Session);

    private ClipboardPayload? RequestBodyPayload =>
        CopyFormatter.FormatBody(Session?.RequestContent);

    private ClipboardPayload? ResponseBodyPayload =>
        CopyFormatter.FormatBody(Session?.ResponseContent);

    private ClipboardPayload? FindingPayload =>
        Session is null
            ? null
            : CopyFormatter.FormatFindings(Session);

    protected override void OnParametersSet()
    {
        if (previousSessionId == Session?.Id)
        {
            return;
        }

        previousSessionId = Session?.Id;
        copyStatus = null;
    }

    private Task SetTrafficViewAsync(DetailTrafficView view) =>
        TrafficViewChanged.InvokeAsync(view);

    private Task CopyUrlAsync() =>
        CopyAsync(
            "URL",
            Session is null ? null : CopyFormatter.FormatUrl(Session));

    private Task CopyRequestHeadersAsync() =>
        CopyAsync(
            "Request headers",
            Session is null
                ? null
                : CopyFormatter.FormatHeaders(Session.RequestHeaders));

    private Task CopyResponseHeadersAsync() =>
        CopyAsync(
            "Response headers",
            Session is null
                ? null
                : CopyFormatter.FormatHeaders(Session.ResponseHeaders));

    private Task CopyRequestBodyAsync() =>
        CopyAsync("Request body", RequestBodyPayload);

    private Task CopyResponseBodyAsync() =>
        CopyAsync("Response body", ResponseBodyPayload);

    private Task CopyFindingsAsync() =>
        CopyAsync("Finding summary", FindingPayload);

    private async Task CopyAsync(
        string label,
        ClipboardPayload? payload)
    {
        if (payload is null)
        {
            copyStatus = $"{label} is not available for this session.";
            copyStatusKind = CopyStatusKind.Error;
            return;
        }

        var sessionId = Session?.Id;
        var result = await ClipboardService.WriteTextAsync(payload.Text);
        if (Session?.Id != sessionId)
        {
            return;
        }

        if (!result.Succeeded)
        {
            copyStatus = $"Unable to copy {label.ToLowerInvariant()}. "
                + (string.IsNullOrWhiteSpace(result.ErrorMessage)
                    ? "Clipboard access failed."
                    : result.ErrorMessage);
            copyStatusKind = CopyStatusKind.Error;
            return;
        }

        if (payload.IncludesTruncationNotice)
        {
            copyStatus = $"{label} copied with a truncation warning.";
            copyStatusKind = CopyStatusKind.Warning;
            return;
        }

        copyStatus = $"{label} copied.";
        copyStatusKind = CopyStatusKind.Success;
    }

    private string GetCopyStatusClass() =>
        copyStatusKind switch
        {
            CopyStatusKind.Success => "success",
            CopyStatusKind.Warning => "warning",
            CopyStatusKind.Error => "error",
            _ => string.Empty
        };

    private string GetTrafficViewButtonClass(DetailTrafficView view) =>
        TrafficView == view
            ? "traffic-view-button active"
            : "traffic-view-button";

    private static RenderFragment RenderHeaders(
        IReadOnlyList<TraceHeader> headers) => builder =>
    {
        if (headers.Count == 0)
        {
            builder.OpenElement(0, "p");
            builder.AddAttribute(1, "class", "muted");
            builder.AddContent(2, "No headers were recorded.");
            builder.CloseElement();
            return;
        }

        var sequence = 0;
        foreach (var header in headers)
        {
            builder.OpenElement(sequence++, "div");
            builder.AddAttribute(sequence++, "class", "header-row");
            builder.OpenElement(sequence++, "span");
            builder.AddContent(sequence++, header.Name);
            builder.CloseElement();
            builder.OpenElement(sequence++, "code");
            builder.AddContent(sequence++, header.Value);
            builder.CloseElement();
            builder.CloseElement();
        }
    };

    private enum CopyStatusKind
    {
        Success,
        Warning,
        Error
    }
}
