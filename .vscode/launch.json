{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run M365 Trace Analyzer",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}\\src\\M365Trace.Web\\bin\\Debug\\net10.0\\M365Trace.Web.dll",
      "cwd": "${workspaceFolder}\\src\\M365Trace.Web",
      "preLaunchTask": "Build M365 Trace Analyzer",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5120"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    }
  ]
}
